# --- Python ---
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Secrets ---
# SMTP credentials are read from the environment; .env is the usual way to load
# them locally. .env.example is the tracked template and carries no values.
.env
.env.*
!.env.example

# --- Runtime state (regenerated every run; never useful in version control) ---
data/
logs/
output/

# --- Input workbook -----------------------------------------------------
# config/companies.xlsx holds the curated company list, and the pipeline
# writes discovered ATS URLs back into it. It is treated as private data by
# default; config/companies.example.xlsx documents the expected format.
# Delete the line below if you intend to publish your list.
#config/companies.xlsx
config/companies.xlsx.bak-*
config/*.bak-*
# Excel's lock file, created whenever the workbook is open in the GUI.
~$*.xlsx

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Excel lock files (created while a workbook is open)
~$*.xlsx

# Logs. Every log this project writes belongs under logs/ (ignored above) and
# holds the latest run only - see the Logging section of README.md. This
# catch-all is for ad-hoc redirects at the repo root, which is how a dozen
# run_output*.log / run_full*.log files accumulated before the policy existed.
*.log

# Local scratch: databases and workbooks copied aside before a risky change.
*.bak
*.bak-*
*.sqlite
*.sqlite3

# Editor / tooling caches that appear only on some machines
.ruff_cache/
.cache/
*.tmp
*.orig
*.rej

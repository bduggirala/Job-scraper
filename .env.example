# Company ATS scraper - environment configuration example
#
# Copy to `.env` and fill in. `.env` is gitignored; this file must never carry
# a real credential. Nothing here is required to run a scrape: with all of it
# unset the run completes normally and writes output/company_jobs.xlsx,
# output/company_jobs.csv and output/company_jobs.json as usual.
#
# Copy this file to `.env` and the scraper reads it automatically on startup
# (settings.load_env_file, called from load_settings). Anything already set in
# the real environment WINS over the file, so exporting a value by hand or
# setting it on a scheduled job still overrides `.env`:
#
#   PowerShell   $env:EMAIL_ENABLED = "true"
#   bash         export EMAIL_ENABLED=true
#   Task Scheduler / cron   set them on the job

# --- Email delivery --------------------------------------------------------
# Master switch. Wins over `notifications.email.enabled` in config/settings.yaml
# in BOTH directions, so a checked-in file can never decide on its own whether a
# run mails a human. Left false, the scraper logs what it would have sent.
EMAIL_ENABLED=false

# Digest recipient(s). Comma- or semicolon-separated for more than one.
# Overrides notifications.email.to.
#
# This is the intended recipient for this deployment, recorded here so the
# address lives in exactly one place. Nothing in the code hard-codes it - the
# pipeline only ever reads SCRAPER_EMAIL_TO (or notifications.email.to, which
# stays a generic placeholder). Copy this file to .env (gitignored) to change
# it locally; sending still requires EMAIL_ENABLED=true and SMTP credentials.
SCRAPER_EMAIL_TO=bharghav.de@gmail.com

# Render the digest to output/digest_preview/ (digest.txt, digest.html,
# digest.eml) instead of sending it. Needs no credentials and opens no
# connection. Deliberately does NOT mark jobs as announced, so the first real
# send still includes everything a preview has seen.
SCRAPER_SMTP_DRY_RUN=false

# --- SMTP credentials ------------------------------------------------------
# Required only when EMAIL_ENABLED=true and SCRAPER_SMTP_DRY_RUN is false.
# Missing values are reported as a skipped send; they never fail a scrape.
#
# For Gmail this needs 2FA plus an App Password
# (https://myaccount.google.com/apppasswords) - an account password is
# rejected. Use smtp.gmail.com with port 587.
SCRAPER_SMTP_HOST=
SCRAPER_SMTP_PORT=587
SCRAPER_SMTP_USER=
SCRAPER_SMTP_PASSWORD=

# Envelope sender, when it differs from the authenticating account.
# Defaults to SCRAPER_SMTP_USER.
SCRAPER_SMTP_FROM=

# STARTTLS on a non-SSL port. Port 465 is implicit SSL and ignores this.
# Turn it off only for a relay that does not offer STARTTLS.
SCRAPER_SMTP_USE_TLS=true
